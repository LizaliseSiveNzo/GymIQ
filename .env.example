# ---- Shared reference (copy relevant vars into backend/.env and web/.env) ----

# Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # backend only, keep secret

# Claude API (AI Coach Summaries)
ANTHROPIC_API_KEY=your-anthropic-key
CLAUDE_MODEL=claude-sonnet-4-6

# Backend
PORT=4000
JWT_SECRET=change-me
CLIENT_URL=http://localhost:5173

# ---- web/.env (MF rebuild) ----
# Set to 1 to hide the new five-tab MF experience and run legacy UI only
# (rollback hatch during Phases 0–7 of docs/MF_REBUILD_ROADMAP.md).
# VITE_LEGACY_UI=1
